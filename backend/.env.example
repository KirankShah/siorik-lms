# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# PostgreSQL database
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Media storage
# Set to True to store uploads on AWS S3 via django-storages instead of the
# local filesystem. AWS credentials below are not required/used while False.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Base URL for certificate verification links encoded in QR codes
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:8000

# Base URL of the React app — used to build the login link in demo-user
# invite emails. Leave as-is for local dev (matches `npm run dev`'s port).
FRONTEND_BASE_URL=http://localhost:5173

# SMTP credentials for outgoing email (demo-user invites, etc). EMAIL_HOST is
# the mail server's hostname (e.g. mail.example.com), not a mailbox address.
# Set exactly one of EMAIL_USE_TLS/EMAIL_USE_SSL to True — typically TLS+587
# or SSL+465, never both.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=risksimplifier@siorik.com

# Slide narration (script via Claude, audio via Azure Neural TTS). Generation
# raises an error until both are set — safe to leave blank in dev.
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Production: comma-separated hostnames Django will serve, e.g.
# ALLOWED_HOSTS=api.example.com,www.example.com
# Leave blank for local dev — DEBUG=True allows localhost automatically.
ALLOWED_HOSTS=

# Production: comma-separated frontend origins allowed to call this API, e.g.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Leave blank for local dev — falls back to the Vite dev server ports.
CORS_ALLOWED_ORIGINS=
