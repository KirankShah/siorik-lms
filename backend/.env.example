# Django
# Generate a real one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# PostgreSQL database
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Media storage
# Set to True to store uploads on AWS S3 via django-storages instead of the
# local filesystem. Strongly recommended in production — see the note next to
# USE_S3 in core/settings.py for why. AWS credentials below are unused while False.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Base URL for certificate verification links encoded in QR codes. This is the
# Django backend's own origin (verify/<token>/ is a backend route), e.g.
# CERTIFICATE_VERIFICATION_BASE_URL=https://api.enterprise.learnwithsiorik.com
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:8000

# Production: comma-separated hostnames Django will serve, e.g.
# ALLOWED_HOSTS=api.enterprise.learnwithsiorik.com
# Leave blank for local dev — DEBUG=True allows localhost automatically.
ALLOWED_HOSTS=

# Production: comma-separated frontend origins allowed to call this API, e.g.
# CORS_ALLOWED_ORIGINS=https://enterprise.learnwithsiorik.com
# Leave blank for local dev — falls back to the Vite dev server ports.
CORS_ALLOWED_ORIGINS=
